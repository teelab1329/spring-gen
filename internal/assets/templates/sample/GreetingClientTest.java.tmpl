package {{ .Package "client" }};

import static org.assertj.core.api.Assertions.assertThat;

import java.io.IOException;
import java.net.InetSocketAddress;
import java.nio.charset.StandardCharsets;

import com.sun.net.httpserver.HttpServer;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.web.client.RestClient;

class GreetingClientTest {

	private HttpServer server;

	private GreetingClient client;

	private String requestedQuery;

	@BeforeEach
	void startStub() throws IOException {
		server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
		server.createContext("/api/hello", (exchange) -> {
			requestedQuery = exchange.getRequestURI().getQuery();
			byte[] body = "{\"status\":\"success\",\"data\":{\"message\":\"Hello, Tee!\"}}".getBytes(StandardCharsets.UTF_8);
			exchange.getResponseHeaders().add("Content-Type", "application/json");
			exchange.sendResponseHeaders(200, body.length);
			exchange.getResponseBody().write(body);
			exchange.close();
		});
		server.start();

		client = new GreetingClient(RestClient.builder()
			.baseUrl("http://127.0.0.1:" + server.getAddress().getPort())
			.build());
	}

	@AfterEach
	void stopStub() {
		server.stop(0);
	}

	@Test
	void sendsTheNameAndMapsTheResponse() {
		assertThat(client.greet("Tee").message()).isEqualTo("Hello, Tee!");
		assertThat(requestedQuery).isEqualTo("name=Tee");
	}

}
