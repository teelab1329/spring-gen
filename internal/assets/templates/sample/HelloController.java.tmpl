package {{ .Package "controller" }};

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import {{ .Package "dto" }}.HelloResponse;
import {{ .Package "model" }}.Greeting;
import {{ .Package "response" }}.JSendResponse;
{{- if eq .Architecture "clean" }}
import {{ .Package "usecase" }}.HelloUseCase;
{{- else }}
import {{ .Package "service" }}.HelloService;
{{- end }}

@RestController
@RequestMapping("/api/hello")
public class HelloController {

	private final {{ if eq .Architecture "clean" }}HelloUseCase{{ else }}HelloService{{ end }} helloService;

	public HelloController({{ if eq .Architecture "clean" }}HelloUseCase{{ else }}HelloService{{ end }} helloService) {
		this.helloService = helloService;
	}

	@GetMapping
	public ResponseEntity<JSendResponse<HelloResponse>> hello(@RequestParam String name) {
		Greeting greeting = helloService.greet(name);
		return ResponseEntity.ok(JSendResponse.success(new HelloResponse(greeting.message())));
	}

}
