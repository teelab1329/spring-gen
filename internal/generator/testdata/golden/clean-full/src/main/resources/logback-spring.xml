<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!--
		Masking is global: redefining %m and registering %maskedEx covers every
		log line, including framework and library output. Spring Boot's base.xml
		still provides the console pattern and the [traceId-spanId] prefix.
	-->
	<conversionRule conversionWord="m" class="com.acme.orderservice.infrastructure.logging.MaskingMessageConverter"/>
	<conversionRule conversionWord="msg" class="com.acme.orderservice.infrastructure.logging.MaskingMessageConverter"/>
	<conversionRule conversionWord="message" class="com.acme.orderservice.infrastructure.logging.MaskingMessageConverter"/>
	<conversionRule conversionWord="maskedEx" class="com.acme.orderservice.infrastructure.logging.MaskingThrowableConverter"/>

	<include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>
